# Database
# Local development: SQLite
DB_PATH=rides.db
# Production: PostgreSQL (pooled - for app runtime)
DATABASE_URL=postgresql://user:pass@host:5432/bikemaster
# Production: PostgreSQL unpooled (for Alembic migrations and sync SQLAlchemy)
DATABASE_URL_UNPOOLED=postgresql://user:pass@host:5432/bikemaster

# API Keys (AI Coach)
AI_COACH_MODE=local
GROQ_API_KEY=
# AI Coach provider order (only GROQ is active)
AI_COACH_PROVIDER_ORDER=groq

# JWT
# IMPORTANTE: genera una chiave sicura (min 32 caratteri). Esempio:
#   openssl rand -hex 32 | head -c 64
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS

# Google OAuth (REQUIRED for Google login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
SECRET_KEY_PREVIOUS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=bikemaster
JWT_AUDIENCE=bikemaster

# CORS (optional)
# Includere l'URL del frontend Vercel quando il backend gira su un PC remoto.
CORS_ORIGINS=http://localhost:8001,http://localhost:8080,http://127.0.0.1:8001,http://127.0.0.1:8080,https://bikemaster-xi.vercel.app

# Maps - OpenStreetMap Nominatim (no API key needed for public instance)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Google Static Maps (optional - falls back to Folium/OSM if not set)
GOOGLE_MAPS_API_KEY=

# Google Fit (optional)
GOOGLE_FIT_SCOPE=https://www.googleapis.com/auth/fitness.activity.read https://www.googleapis.com/auth/fitness.location.read

# Strava (optional - enables the Strava import panel)
# Get Client ID/Secret from https://www.strava.com/settings/api
# The redirect URI MUST match the "Authorization Callback Domain" in the Strava app.
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:8001/api/v1/import/strava/callback
STRAVA_SCOPE=activity:read_all

# Analytics (optional)
MAX_SPEED_KM_H=120.0
PAUSE_SPEED_THRESHOLD=1.5
PAUSE_DURATION_THRESHOLD_S=180.0
ACCELERATION_THRESHOLD=2.0
CALORIE_EFFICIENCY_FACTOR=0.25
CALORIE_BENCHMARK_KCAL_KM=30.0
FATIGUE_WEIGHT_DURATION=0.30
FATIGUE_WEIGHT_HR=0.30
FATIGUE_WEIGHT_SPEED=0.20
FATIGUE_WEIGHT_ELEVATION=0.10
FATIGUE_WEIGHT_WEIGHT=0.10

# Traffic / Road Safety (optional)
INCIDENT_DATA_PATH=
INCIDENT_API_URL=
INCIDENT_API_KEY=
INCIDENT_RADIUS_KM=5.0
INCIDENT_DAYS=90

# Redis (for caching and rate limiting in production)
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=300

# Background Tasks
TASK_QUEUE_WORKERS=2

# Weather (for weather API integration)
WEATHER_API_KEY=
WEATHER_CACHE_HOURS=6
WEATHER_UNITS=metric

# Environment (development, staging, production)
ENVIRONMENT=development

# Sentry Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Vercel Cron (serverless function at /api/cron)
# Set CRON_SECRET in the Vercel project; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Base URL of the Render-hosted backend pinged by the cron keep-alive (default below).
BACKEND_URL=https://bikemaster-api.onrender.com

# === Backend API ===
API_HOST=0.0.0.0
API_PORT=8001

# === OAuth Redirect Allow-list ===
# Custom URI schemes allowed as OAuth redirect targets (e.g. mobile deep links).
OAUTH_REDIRECT_SCHEMES=com.bikemaster.app
# Comma-separated hosts additionally allowed as OAuth redirect_uri targets.
OAUTH_ALLOWED_REDIRECT_HOSTS=localhost

# === Migrations ===
# Set to 0 to disable auto-running Alembic migrations on app startup.
RUN_MIGRATIONS_ON_STARTUP=1
# Set to 1 to run migrations with the local SQLite db_path instead of PostgreSQL.
RUN_LOCAL_MIGRATIONS=0
ALEMBIC_CONFIG=alembic.ini

# === OpenTelemetry ===
OTEL_SERVICE_NAME=bikemaster
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_ENVIRONMENT=development

# === SerpApi / Google Maps enrichment ===
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_maps
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_MONTHLY_BUDGET=250

# === Map provider ===
# Select the map rendering backend: "folium" (default) or "aethermap".
BIKEMASTER_MAP_PROVIDER=folium
GOOGLE_MAPS_ZOOM=13
GOOGLE_MAPS_SIZE=800x600
DEFAULT_MAP_STYLE=standard
# AetherMap terrain enrichment
AETHERMAP_DEM_CACHE=.cache/aethermap/dem
AETHERMAP_DEM_SOURCE=auto
TERRAIN_ENRICHMENT_ENABLED=0

# === Google Health (optional) ===
GOOGLE_HEALTH_SCOPE=https://www.googleapis.com/auth/googlehealth.activity.read https://www.googleapis.com/auth/googlehealth.location.read
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# === Google Fit OAuth2 (defaults to generic Google client) ===
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# === Garmin (optional) ===
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_SCOPE=read

# === Wahoo (optional) ===
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_REDIRECT_URI=
WAHOO_SCOPE=workouts_read user_read

# === AI Coach ===
AI_COACH_CHAT_RETENTION_DAYS=90
GROQ_MODEL=llama-3.3-70b-versatile

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=
LOG_REQUEST_ID_HEADER=X-Request-ID
AUDIT_LOG_PATH=audit.log

# === Monitoring ===
PROMETHEUS_PORT=9090

# === Events / Sync ===
EVENT_BUS_STRICT_MODE=false
SYNC_DEFAULT_MODE=never
SYNC_CLOUD_URL=
SYNC_AUTH_TOKEN=
SYNC_DEVICE_ID=
SYNC_DAILY_HOUR=2
SYNC_WEEKLY_DAY=0
SYNC_AUTO_ON_STARTUP=0

# === GPS Parsing ===
GPS_DECIMATION_TOLERANCE=0.00005
GPS_MAX_POINTS=0

# === Alertmanager ===
ALERTMANAGER_WEBHOOK_TOKEN=
