#!/bin/sh

APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
elif [ -x "/c/Program Files/Android/Android Studio/jbr/bin/java" ]; then
    JAVACMD="/c/Program Files/Android/Android Studio/jbr/bin/java"
elif [ -x "$APP_HOME/../../Android Studio/jbr/bin/java" ]; then
    JAVACMD="$APP_HOME/../../Android Studio/jbr/bin/java"
else
    echo "ERROR: JAVA_HOME is not set and no Java executable was found."
    echo "Please set JAVA_HOME or install Android Studio/JDK."
    exit 1
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain "$@"
