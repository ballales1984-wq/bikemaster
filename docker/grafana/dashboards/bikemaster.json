{
  "dashboard": {
    "title": "BikeMaster Overview",
    "uid": "bikemaster-overview",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"},
    "tags": ["bikemaster", "cycling"],
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_http_requests_total[5m]))",
            "legendFormat": "req/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 2,
        "title": "HTTP Latency (p95)",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(bikemaster_http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 2, "color": "red"}
              ]
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_http_requests_total{status_code=~\"4..|5..\"}[5m])) / sum(rate(bikemaster_http_requests_total[5m])) * 100",
            "legendFormat": "error %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 4,
        "title": "Active Users",
        "type": "gauge",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "bikemaster_active_users",
            "legendFormat": "active",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            },
            "max": 100,
            "unit": "short"
          }
        }
      },
      {
        "id": 5,
        "title": "HTTP Requests by Endpoint",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "topk(10, sum by (endpoint) (rate(bikemaster_http_requests_total[5m])))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "options": {"orientation": "horizontal", "showUnfilled": true}
      },
      {
        "id": 6,
        "title": "HTTP Latency (p50/p95/p99)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(bikemaster_http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(bikemaster_http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(bikemaster_http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 7,
        "title": "Rides Processed",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_rides_processed_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "rps"}}
      },
      {
        "id": 8,
        "title": "GPS Imports by Format",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_gps_imports_total[5m])) by (format)",
            "legendFormat": "{{format}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "rps"}}
      },
      {
        "id": 9,
        "title": "AI Coach Queries by Provider",
        "type": "timeseries",
        "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_ai_coach_queries_total[5m])) by (provider, status)",
            "legendFormat": "{{provider}}/{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "rps"}}
      },
      {
        "id": 10,
        "title": "Ride Analysis Duration (p95)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 18, "w": 8, "h": 6},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(bikemaster_ride_analysis_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95 duration",
            "refId": "A"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 11,
        "title": "Fatigue Score Distribution",
        "type": "heatmap",
        "gridPos": {"x": 8, "y": 18, "w": 8, "h": 6},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_fatigue_score_bucket[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ],
        "options": {"calculate": true, "cells": "auto"}
      },
      {
        "id": 12,
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {"x": 16, "y": 18, "w": 8, "h": 6},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "targets": [
          {
            "expr": "sum(rate(bikemaster_cache_hits_total[5m])) / (sum(rate(bikemaster_cache_hits_total[5m])) + sum(rate(bikemaster_cache_misses_total[5m]))) * 100",
            "legendFormat": "hit rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 50, "color": "yellow"},
                {"value": 80, "color": "green"}
              ]
            },
"unit": "percent"
           }
         }
       },
       {
         "id": 14,
         "title": "Tracking Sessions",
         "type": "stat",
         "gridPos": {"x": 0, "y": 24, "w": 6, "h": 4},
         "datasource": {"type": "prometheus", "uid": "prometheus"},
         "targets": [
           {
             "expr": "sum(rate(bikemaster_tracking_sessions_total[5m]))",
             "legendFormat": "sessions",
             "refId": "A"
           }
         ],
         "fieldConfig": {"defaults": {"unit": "s"}}
       },
       {
         "id": 15,
         "title": "Active Athletes (30min)",
         "type": "stat",
         "gridPos": {"x": 6, "y": 24, "w": 6, "h": 4},
         "datasource": {"type": "prometheus", "uid": "prometheus"},
         "targets": [
           {
             "expr": "bikemaster_active_athletes",
             "legendFormat": "athletes",
             "refId": "A"
           }
         ],
         "fieldConfig": {"defaults": {"unit": "short"}}
       }
     ]
   }
 }
