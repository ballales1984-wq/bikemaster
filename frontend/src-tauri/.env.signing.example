# Windows code-signing configuration for local Tauri builds
#
# When these variables are set, `tauri build` will automatically sign
# the .exe, .msi, and .nsis installers during the build process.
#
# For local dev: generate a self-signed cert with:
#   pwsh scripts/sign-windows.ps1 -GenerateCert
#
# For production: obtain a CA-signed code-signing certificate (e.g.
# ZeroSSL, DigiCert, Sectigo) and set WINDOWS_CERTIFICATE (base64 PFX)
# + WINDOWS_CERTIFICATE_PASSWORD as GitHub Actions secrets (see
# .github/workflows/tauri-release.yml — handled by tauri-action@v2).

# Path to the .pfx / PKCS#12 certificate file
TAURI_SIGNING_PRIVATE_KEY=C:\Users\user\AppData\Local\Temp\bikemaster-codesign.pfx

# Password for the certificate
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=BikeMasterDev123!
