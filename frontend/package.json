{
  "name": "bikemaster-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --pool=threads",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report playwright-report",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "android:build": "npm run build && cap sync && cd android && ./gradlew assembleRelease",
    "android:install": "npm run build && cap sync && cd android && ./gradlew installDebug"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.4",
    "@capacitor/core": "^5.7.4",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.4",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^22.1.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "0.16.7",
    "vitest": "^1.4.0"
  },
  "overrides": {
    "@babel/core": "7.24.7",
    "@babel/helper-module-transforms": "7.24.7"
  },
  "capacitor": {
    "appId": "com.bikemaster.app",
    "appName": "BikeMaster",
    "webDir": "dist",
    "plugins": {
      "BikeTracking": {
        "android": {
          "locationAccuracy": "high",
          "stationaryRadius": 10,
          "distanceFilter": 5
        }
      }
    },
    "android": {
      "captivePortal": false,
      "hostname": "localhost",
      "backgroundColor": "#0f172a"
    }
  }
}
