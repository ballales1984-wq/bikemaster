{
  "name": "bikemaster-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --pool=threads",
    "test:e2e": "playwright test",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "android:build": "npm run build && cap sync && cd android && ./gradlew assembleRelease",
    "android:install": "npm run build && cap sync && cd android && ./gradlew installDebug"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.4",
    "@capacitor/core": "^5.7.4",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^5.1.0"
  },
  "overrides": {
    "@babel/core": "7.24.7",
    "@babel/helper-module-transforms": "7.24.7"
  },
  "capacitor": {
    "appId": "com.bikemaster.app",
    "appName": "BikeMaster",
    "webDir": "dist",
    "plugins": {
      "BikeTracking": {
        "android": {
          "locationAccuracy": "high",
          "stationaryRadius": 10,
          "distanceFilter": 5
        }
      }
    },
    "android": {
      "captivePortal": false,
      "hostname": "localhost",
      "backgroundColor": "#0f172a"
    }
  }
}
