{
  "name": "bikemaster-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "android:build": "npm run build && cap sync && cd android && ./gradlew assembleRelease",
    "android:install": "npm run build && cap sync && cd android && ./gradlew installDebug"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.4",
    "@capacitor/core": "^5.7.4",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.4",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/test-utils": "^2.4.0",
    "playwright": "^1.44.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^1.4.0"
  },
  "capacitor": {
    "appId": "com.bikemaster.app",
    "appName": "BikeMaster",
    "webDir": "dist",
    "android": {
      "captivePortal": false,
      "hostname": "localhost"
    }
  }
}
