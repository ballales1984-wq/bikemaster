{
  "name": "bikemaster-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:300})}catch(e){}\"",
    "build": "node scripts/safe-build.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit --incremental",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-pattern node_modules,.git,dist,.output"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tauri-apps/api": "^2.5.0",
    "@types/dompurify": "^3.0.5",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.11",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.5.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^22.1.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.4",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
